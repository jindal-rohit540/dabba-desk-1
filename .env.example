# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# --- Clerk (dashboard.clerk.com → API Keys). Locally: `npx clerk@latest init --accountless` writes temporary keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Shared secrets (any long random string: `openssl rand -hex 32`)
PARTNER_WEBHOOK_SECRET=
CRON_SECRET=

# --- WhatsApp via Twilio (stretch)
TWILIO_AUTH_TOKEN=
